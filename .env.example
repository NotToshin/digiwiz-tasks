# Server-side example. Use environment-specific values for production.
NODE_ENV=development
PORT=63479
APP_ORIGIN=http://127.0.0.1:63477
APP_TIME_ZONE=Asia/Dhaka
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=digiwiz_tasks
DB_USER=
DB_PASSWORD=
SESSION_SECRET=
# SMTP — required for production email delivery (OTP, password reset)
# Production: Hostinger SMTP or other authenticated relay with STARTTLS on port 587
# Leave SMTP_HOST empty to write emails to .local/mail/ (local dev only)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=no-reply@digiwiz.com.bd
SMTP_PASSWORD=
MAIL_FROM="Digiwiz Tasks" <no-reply@digiwiz.com.bd>
OFFICE_ALLOWED_CIDRS=
TRUSTED_PROXY_CIDRS=
PRIVATE_UPLOAD_DIR=


# For local testing only, explicitly configure OFFICE_ALLOWED_CIDRS=127.0.0.1/32,::1/128.
# Configure real office egress addresses before staging. Empty means deny all.
# Production NODE_ENV: set NODE_ENV=production in Hostinger environment variables.
